# Pin LF line endings for files that are byte-compared in tests or by
# `make generate-check`. Without this, Git's default autocrlf behaviour on
# Windows checkouts converts LF to CRLF, breaking golden-file equality
# checks (the renderer always emits LF) and producing spurious CRLF/LF
# diffs in `git diff --exit-code` after `go generate`.
internal/skill/render/testdata/** text eol=lf
internal/commands/mcp/**/testdata/** text eol=lf
internal/commands/mcp/testdata/** text eol=lf
internal/skill/neo4jcli/bundle/** text eol=lf
internal/skill/neo4jcli/additions.md text eol=lf
internal/skill/neo4jcli/query-additions.md text eol=lf
internal/skill/neo4jcli/description.txt text eol=lf

# Pin LF for CI script and bats test files. A CRLF shebang (#!/usr/bin/env bash\r)
# makes the kernel look for an interpreter named "bash\r", so the script fails
# to execute on Linux runners.
.github/scripts/**/*.sh text eol=lf
.github/scripts/**/*.bats text eol=lf

# Pin LF for distribution-channel scripts and templates. The npm publish
# script (`distribution/npm/publish.sh`) and committed `*.tmpl` / `*.js`
# / `*.json` / `*.tsv` files must stay LF on Windows checkouts so they
# render byte-identically across runners.
distribution/**/*.json text eol=lf
distribution/**/*.tmpl text eol=lf
distribution/**/*.js text eol=lf
distribution/**/*.sh text eol=lf
distribution/**/*.tsv text eol=lf
